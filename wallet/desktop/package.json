{
  "name": "@citizen/wallet-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "doctor:linux": "bash ./scripts/doctor-linux-runtime.sh",
    "doctor:linux:fix": "bash ./scripts/doctor-linux-runtime.sh --fix",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:tauri": "cargo test -p citizen-wallet-desktop --manifest-path src-tauri/Cargo.toml",
    "tv3:evidence-pack": "node scripts/tv3-evidence-pack.mjs",
    "tv3:audit-packet-template": "node scripts/tv3-audit-packet-template.mjs",
    "tv3:gate-check": "node scripts/tv3-completion-gate-check.mjs",
    "tv3:gate-check:allow-incomplete": "node scripts/tv3-completion-gate-check.mjs --allow-incomplete",
    "tv3:audit-evidence-stubs": "node scripts/tv3-audit-evidence-stubs.mjs",
    "tv3:release-evidence-template": "node scripts/tv3-release-evidence-template.mjs",
    "tv3:signed-artifact-evidence-stubs": "node scripts/tv3-signed-artifact-evidence-stubs.mjs",
    "tv3:checklist-link-report": "node scripts/tv3-checklist-link-report.mjs",
    "tv3:portable-smoke-suite": "node scripts/tv3-portable-smoke-suite.mjs",
    "tv3:portable-smoke-suite:allow-failures": "node scripts/tv3-portable-smoke-suite.mjs --allow-failures",
    "tv3:portable-smoke-gate": "node scripts/tv3-portable-smoke-gate.mjs",
    "tv3:portable-smoke-gate:allow-incomplete": "node scripts/tv3-portable-smoke-gate.mjs --allow-incomplete",
    "tv3:portable-smoke-evidence-template": "node scripts/tv3-portable-smoke-evidence-template.mjs",
    "tv3:portable-smoke-signed-evidence-stubs": "node scripts/tv3-portable-smoke-signed-evidence-stubs.mjs",
    "tv3:ux-signoff-template": "node scripts/tv3-ux-signoff-template.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "packageManager": "pnpm@10.12.1"
