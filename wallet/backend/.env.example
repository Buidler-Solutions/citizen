PORT=4499

# Comma-separated list of frontend origins allowed to call /auth/*
# Include every onboarding UI origin you run locally.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Session signing secret (set a strong value outside local dev).
AUTH_SESSION_SECRET=dev-insecure-secret-change-me

# Optional: key rotation format kid:secret,kid2:secret2
# AUTH_SESSION_SECRETS=v1:replace-with-long-random-secret

# Optional auth/session behavior tuning
# AUTH_CHALLENGE_TTL_MS=300000
# AUTH_SESSION_TTL_MS=1800000
# AUTH_MAX_VERIFY_ATTEMPTS=5
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=30
