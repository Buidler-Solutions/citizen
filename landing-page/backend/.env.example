# Backend server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection (local run without Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=citizen
DB_PASSWORD=citizen
DB_NAME=citizen_landing

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Email / onboarding notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_REPLY_TO=
SMTP_DEFAULT_BCC=
SMTP_REJECT_UNAUTHORIZED=true
SMTP_REQUIRED=false
ONBOARDING_SUPPORT_EMAIL=
ONBOARDING_NOTIFICATION_EMAILS=
ONBOARDING_ADMIN_DASHBOARD_URL=http://localhost:3000/admin/dashboard
ONBOARDING_RESET_PASSWORD_URL=http://localhost:3000/admin/reset-password
ONBOARDING_ADMIN_LOGIN_URL=http://localhost:3000/admin/login
PASSWORD_RESET_TTL_MINUTES=60
ONBOARDING_UPDATE_QUEUE_THRESHOLD=25
ONBOARDING_UPDATE_SYNC_LIMIT=100
