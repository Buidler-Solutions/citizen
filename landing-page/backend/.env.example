# Backend server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection (local run without Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USER=citizen
DB_PASSWORD=citizen
DB_NAME=citizen_landing

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Email / onboarding notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_REPLY_TO=
SMTP_DEFAULT_BCC=
SMTP_REJECT_UNAUTHORIZED=true
SMTP_REQUIRED=false
ONBOARDING_SUPPORT_EMAIL=
ONBOARDING_NOTIFICATION_EMAILS=
ONBOARDING_ADMIN_DASHBOARD_URL=http://localhost:3000/admin/dashboard
ONBOARDING_RESET_PASSWORD_URL=http://localhost:3000/admin/reset-password
ONBOARDING_ADMIN_LOGIN_URL=http://localhost:3000/admin/login
PASSWORD_RESET_TTL_MINUTES=60
ONBOARDING_UPDATE_QUEUE_THRESHOLD=25
ONBOARDING_UPDATE_SYNC_LIMIT=100

# Optional relay endpoint for posting signed onboarding payload metadata to Citizen network
CITIZEN_SIGNED_SUBMISSION_RELAY_URL=


# Relay target
CITIZEN_SIGNED_SUBMISSION_RELAY_URL=http://127.0.0.1:8091/api/v1/envelopes/submit
CITIZEN_SIGNED_SUBMISSION_RELAY_FORMAT=runtime_envelope

# Runtime author + namespace policy alignment
CITIZEN_SIGNED_SUBMISSION_RUNTIME_AUTHOR=forms.commitment
CITIZEN_SIGNED_SUBMISSION_RUNTIME_NAMESPACE=forms.commitment
CITIZEN_SIGNED_SUBMISSION_RUNTIME_ACTION=SUBMIT_ONBOARDING_INTEREST

# Required signer key (Ed25519 PKCS#8 PEM)
CITIZEN_SIGNED_SUBMISSION_RUNTIME_SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Retry behavior
CITIZEN_SIGNED_SUBMISSION_RELAY_MAX_ATTEMPTS=3
CITIZEN_SIGNED_SUBMISSION_RELAY_RETRY_BACKOFF_MS=250
