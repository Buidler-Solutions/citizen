{
  "name": "vaultier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite",
    "test:headless-contract": "pnpm check:priority-gap && node headless-contract-check.mjs && node operation-copy-check.mjs",
    "check:priority-gap": "node checklist-gap-check.mjs",
    "check:priority-gap:json": "node checklist-gap-check.mjs --json",
    "check:priority-gap:strict": "pnpm check:priority-gap",
    "check:evidence-packet": "node maintainer-evidence-packet.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
