{
  "name": "vaultier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite",
    "test:headless-contract": "pnpm check:priority-gap && node headless-contract-check.mjs && node runtime-parity-check.mjs && node wb-mode-fixture-check.mjs && node operation-copy-check.mjs && pnpm check:reminders",
    "check:priority-gap": "node checklist-gap-check.mjs",
    "check:priority-gap:json": "node checklist-gap-check.mjs --json",
    "check:priority-gap:strict": "node checklist-gap-check.mjs --strict-stale-unchecked --full-summary",
    "check:evidence-packet": "node maintainer-evidence-packet.mjs",
    "test": "pnpm test:headless-contract",
    "check:checklist-audit": "node checklist-audit.mjs",
    "check:checklist-audit:json": "node checklist-audit.mjs --json",
    "check:reminders": "node reminder-policy-check.mjs",
    "check:priority-gap:full": "node checklist-gap-check.mjs --full-summary",
    "test:headless-contract:strict": "pnpm check:priority-gap:strict && node headless-contract-check.mjs && node runtime-parity-check.mjs && node wb-mode-fixture-check.mjs && node operation-copy-check.mjs && pnpm check:reminders"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
