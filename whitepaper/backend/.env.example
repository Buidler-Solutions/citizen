# Whitepaper backend sample environment configuration
# Copy to .env for local development only.

# Required for DB-backed whitepaper APIs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citizen_whitepaper

# Admin console login password (used by POST /admin/login)
WHITEPAPER_ADMIN_PASSWORD=CitizenAdmin123!

# Secret used to sign admin bearer tokens
WHITEPAPER_ADMIN_SECRET=replace-with-long-random-secret

# Optional fallback secret used elsewhere in Nest app
JWT_SECRET=replace-with-long-random-secret

# Frontend origin allowed to call backend APIs
CORS_ORIGIN=http://localhost:3000

# Base URL where frame image assets are hosted
ASSET_BASE_URL=http://localhost:3000/frames

# Public API cache TTL in seconds
CACHE_TTL_SECONDS=30

# Nest app port
PORT=4000
