{
  "name": "@citizen-protocol/typescript-sdk",
  "version": "0.1.0",
  "description": "Node.js SDK for submitting signed CITIZEN protocol envelopes and retrieving deterministic receipts.",
  "type": "module",
  "main": "dist/cjs/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist dist-test",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "test": "npm run build && npm run build:test && node --test dist-test/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck:public": "tsc -p tsconfig.types.json",
    "lint": "eslint . --ext .ts,.mts --max-warnings=0",
    "format:check": "prettier --check \"docs/**/*.md\" \"package.json\"",
    "smoke:live": "npm run build && node scripts/live_node_smoke.mjs",
    "release:check": "npm run typecheck && npm test && npm run build && npm run lint && npm run format:check && npm run api:check && npm run changelog:check",
    "release:pack": "npm run release:check && npm pack --dry-run",
    "release:next": "npm run release:check && npm publish --tag next",
    "api:report": "npm run build && node scripts/generate_api_report.mjs --write",
    "api:check": "npm run build && node scripts/generate_api_report.mjs --check",
    "example:build": "tsc -p tsconfig.examples.json",
    "changelog:generate": "node scripts/generate_changelog.mjs",
    "changelog:check": "node scripts/generate_changelog.mjs --check"
  },
  "license": "Apache-2.0",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "module": "dist/esm/index.js",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "js-yaml": ">=4.3.1",
    "minimatch": ">=11.0.1"
  }
}
