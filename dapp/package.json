{
  "name": "citizen-dapp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev": "npm run dev:api & npm run dev:web",
    "lint": "npm --workspace apps/web run lint && npm --workspace apps/api run lint"
  },
  "overrides": {
    "@nestjs/common": {
      "file-type": "21.3.2"
    },
    "@nestjs/platform-express": {
      "multer": "^2.2.0"
    },
    "file-type": "21.3.2",
    "multer": "^2.2.0",
    "path-to-regexp": "8.4.2",
    "postcss": "^8.5.18",
    "qs": "^6.15.2",
    "ws": "^8.21.0"
  }
}
